+func (h *cachedDNSFlowHandler) NewDNSPacketEx(ctx context.Context, payload []byte, source, destination M.Socksaddr, writer N.PacketWriter) {
+	h.dns.NewDNSPacketEx(ctx, payload, source, destination, writer)
+}
