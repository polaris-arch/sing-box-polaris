+func openFixtureFlow(t *testing.T, p *Port) *Destination {
+	t.Helper()
+	d, err := p.flowFor(netip.MustParseAddr("198.18.0.1"), netip.MustParseAddr("192.0.2.1"), 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
