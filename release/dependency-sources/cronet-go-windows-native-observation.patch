+func TestNaiveIdleSealWaitsForNativeWorkAndStreams(t *testing.T) {
+	c := lifecycleTestClient(clientStateRunning)
+	idle := make(chan struct{}, 1)
+	c.onIdle = func() { idle <- struct{}{} }
