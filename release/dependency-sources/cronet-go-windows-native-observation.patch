+		return nil, errors.New("cronet: selected path was already mapped before object capture")
+	}
+	if !errors.Is(err, windows.ERROR_MOD_NOT_FOUND) {
+		return nil, fmt.Errorf("cronet: query preexisting selected module: %w", err)
+	}
