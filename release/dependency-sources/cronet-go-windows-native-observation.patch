+func (capture *windowsLibraryCapture) close() error {
+	var failures []error
+	if capture.file != nil {
+		failures = append(failures, capture.file.Close())
+	}
+	if capture.parent != 0 {
+		failures = append(failures, windows.CloseHandle(capture.parent))
+	}
+	return errors.Join(failures...)
