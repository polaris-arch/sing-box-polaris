{
  "all": {
    "workflow": ".github/workflows/build.yml",
    "payloadRules": {
      "binary-darwin_amd64": [
        {
          "pattern": "sing\\-box\\-{version}\\-darwin\\-amd64\\.tar\\.gz",
          "count": 1
        }
      ],
      "binary-darwin_arm64": [
        {
          "pattern": "sing\\-box\\-{version}\\-darwin\\-arm64\\.tar\\.gz",
          "count": 1
        }
      ],
      "binary-linux_amd64-purego": [
        {
          "pattern": "sing\\-box\\-{version}\\-linux\\-amd64\\.tar\\.gz",
          "count": 1
        }
      ],
      "binary-linux_arm64-purego": [
        {
          "pattern": "sing\\-box\\-{version}\\-linux\\-arm64\\.tar\\.gz",
          "count": 1
        }
      ],
      "binary-native-index": [
        {
          "pattern": "polaris\\-upstream\\-native\\-assets\\.json",
          "count": 1
        },
        {
          "pattern": "sing-box-polaris-source-[0-9a-f]{40}\\.tar\\.gz",
          "count": 1
        }
      ],
      "binary-windows_amd64": [
        {
          "pattern": "sing\\-box\\-{version}\\-windows\\-amd64\\.zip",
          "count": 1
        }
      ],
      "publisher-run-receipt": [
        {
          "pattern": "publisher\\-run\\-receipt\\.json",
          "count": 1
        }
      ],
      "smoke-darwin-amd64": [],
      "smoke-darwin-arm64": [],
      "smoke-linux-amd64-purego": [],
      "smoke-linux-arm64-purego": [],
      "smoke-windows-amd64": [],
      "native-controlled-peer": [
        {
          "pattern": "receipt\\.json",
          "count": 1
        }
      ]
    }
  }
}
