diff --git a/src/os/root_removeall_polaris_windows_test.go b/src/os/root_removeall_polaris_windows_test.go
new file mode 100644
--- /dev/null
+++ b/src/os/root_removeall_polaris_windows_test.go
@@ -0,0 +1,102 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build windows
+
+package os_test
+
+import (
+	"internal/syscall/windows"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+// No races are needed: the intermediate reparse point is already outside Root.
+// The fallback flag exercises the official older-Windows handle-based deletion,
+// rather than silently testing only modern FileDispositionInformationEx.
+func TestPolarisRootRemoveAllConfinement(t *testing.T) {
+	originalFallback := windows.TestDeleteatFallback
+	defer func() { windows.TestDeleteatFallback = originalFallback }()
+	for _, fallback := range []bool{false, true} {
+		name := "native"
+		if fallback {
+			name = "legacy-fallback"
+		}
+		t.Run(name, func(t *testing.T) {
+			windows.TestDeleteatFallback = fallback
+			for _, kind := range []string{"ordinary", "junction", "symlink"} {
+				t.Run(kind, func(t *testing.T) {
+					base := t.TempDir()
+					inside, outside := filepath.Join(base, "root"), filepath.Join(base, "outside")
+					for _, dir := range []string{inside, outside} {
+						if err := os.Mkdir(dir, 0700); err != nil {
+							t.Fatal(err)
+						}
+					}
+					victim := filepath.Join(outside, "victim")
+					const original = "outside bytes must survive"
+					if err := os.WriteFile(victim, []byte(original), 0600); err != nil {
+						t.Fatal(err)
+					}
+					root, err := os.OpenRoot(inside)
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer root.Close()
+					if kind == "ordinary" {
+						dir := filepath.Join(inside, "sub", "nested")
+						if err := os.MkdirAll(dir, 0700); err != nil {
+							t.Fatal(err)
+						}
+						if err := os.WriteFile(filepath.Join(dir, "child"), []byte("inside"), 0600); err != nil {
+							t.Fatal(err)
+						}
+						if err := root.RemoveAll("sub"); err != nil {
+							t.Fatal(err)
+						}
+						if _, err := os.Stat(filepath.Join(inside, "sub")); !os.IsNotExist(err) {
+							t.Fatalf("normal deletion failed: %v", err)
+						}
+						if err := root.RemoveAll("missing"); err != nil {
+							t.Fatal(err)
+						}
+					} else {
+						link := filepath.Join(inside, "link")
+						if kind == "junction" {
+							if output, err := exec.Command("cmd", "/c", "mklink", "/J", link, outside).CombinedOutput(); err != nil {
+								t.Fatalf("required junction setup: %v: %s", err, output)
+							}
+						} else if err := os.Symlink(outside, link); err != nil {
+							t.Fatalf("required symlink setup: %v", err)
+						}
+						defer os.Remove(link)
+						for _, target := range []string{filepath.Join("link", "victim"), filepath.Join("link", "victim") + string(os.PathSeparator)} {
+							if err := root.RemoveAll(target); err == nil {
+								t.Fatalf("outside traversal %q accepted", target)
+							}
+							data, err := os.ReadFile(victim)
+							if err != nil || string(data) != original {
+								t.Fatalf("outside victim changed: %q %v", data, err)
+							}
+						}
+						// Removing the final reparse point must remove the link,
+						// without following it and deleting its outside target.
+						if err := root.RemoveAll("link"); err != nil {
+							t.Fatal(err)
+						}
+						if _, err := os.Lstat(link); !os.IsNotExist(err) {
+							t.Fatalf("link was not removed: %v", err)
+						}
+					}
+					data, err := os.ReadFile(victim)
+					if err != nil || string(data) != original {
+						t.Fatalf("outside victim changed: %q %v", data, err)
+					}
+				})
+			}
+		})
+	}
+}
